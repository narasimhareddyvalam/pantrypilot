# PantryPilot settings. Copy this file to .env, then change what you need.

# 0.0.0.0 lets a phone on the same Wi-Fi open the app. Use 127.0.0.1 to keep it on this laptop only.
HOST=0.0.0.0

# The port in the address, like http://localhost:5001
PORT=5001

# Debug mode shows code details when something breaks. Keep it false on shared networks.
DEBUG=false
