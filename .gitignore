# Secrets and local settings
.env

# Python
.venv/
__pycache__/
.pytest_cache/

# Data that each computer makes for itself
*.db
data/

# Model weights stay out of Git (see models/cnn/README.md and models/bert/README.md).
# The exceptions are the two small models the scanner needs to read labels:
# the date CNN (6 MB) and the label-type BERT (18 MB).
*.keras
*.h5
!models/cnn/date_cnn.keras
!models/bert/label_model/*.h5

# macOS
.DS_Store

# Scratch files from the AI coding assistant (local only)
.superpowers/
